# Required only if you want app password (leave empty for dev = no password)
SIMPLE_PASSWORD=changeme

# LLM: Gemini (Vertex AI) is tried first if GEMINI_PROJECT_ID + GEMINI_CLIENT_EMAIL + GEMINI_PRIVATE_KEY are set.
# Otherwise Azure OpenAI is used if AZURE_* are set. Otherwise mock.
# --- Gemini (Vertex AI service account) ---
GEMINI_PROJECT_ID=your-gcp-project-id
GEMINI_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
GEMINI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GEMINI_PRIVATE_KEY_ID=optional-key-id
GEMINI_CLIENT_ID=optional
GEMINI_TOKEN_URI=https://oauth2.googleapis.com/token
GEMINI_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GEMINI_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GEMINI_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...
# Required for Vertex AI – region where Gemini is enabled (e.g. us-central1, europe-west1)
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-3-pro
# --- Azure OpenAI (fallback if Gemini not set or fails) ---
AZURE_OPENAI_API_KEY=your_azure_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_VERSION=2024-12-01-preview

# Optional: persistence (leave unset for in-memory). Backend accepts MONGO_URI or MONGODB_URI
MONGO_URI=mongodb://localhost:27017/prompt_builder
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
POSTGRES_DSN=postgresql://user:password@localhost:5432/prompt_builder
REDIS_URL=redis://localhost:6379/0

# Optional: frontend only – backend URL if not http://localhost:8000
# PROMPT_BUILDER_API_URL=http://localhost:8000

# Optional: deploy webhook – POST prompt to this URL when deploy is called
# DEPLOY_WEBHOOK_URL=https://your-voice-platform.com/api/import
